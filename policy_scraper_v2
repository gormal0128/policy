import requests
from bs4 import BeautifulSoup
from openai import OpenAI
from datetime import datetime
import json
import os
import time
from collections import defaultdict

# ==========================================
# 1. 설정 및 OpenAI 연동
# ==========================================
RSS_URL = "https://www.policytracker.com/feed/"
HEADERS = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'}

OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")
client = OpenAI(api_key=OPENAI_API_KEY)

DB_FILE = "policy_db.json"
HTML_FILE = "index2.html"

# ==========================================
# 2. 데이터베이스(JSON) 관리 함수
# ==========================================
def load_db():
    """기존에 저장된 기사 목록을 불러옵니다."""
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return []

def save_db(data):
    """기사 목록을 파일로 저장합니다."""
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=4)

# ==========================================
# 3. GPT 번역 및 분류 함수 (제목·본문 번역 + 요약 + 카테고리 분류)
# ==========================================
def gpt_translate_all(title_en, summary_en, full_text_en, max_retries=3):
    """
    제목과 본문은 번역하고, 요약 생성 및 카테고리/주파수 대역 추출을 함께 수행합니다.
    """
    prompt = f"""아래 [TITLE]과 [FULL_TEXT]를 바탕으로 지시사항을 수행하고,
다음 JSON 형식으로만 출력하세요. 설명, 주석, 마크다운 코드블록(```)은 절대 포함하지 마세요.

{{
  "title_ko": "번역된 제목",
  "summary_ko": "본문의 핵심 내용을 2~3줄로 직접 요약한 한국어 텍스트",
  "full_text_ko": "전체 본문 번역본",
  "category": "다음 4개 중 가장 적합한 하나를 정확히 선택: [🛰️ 위성통신 및 D2D, 📱 차세대 이동통신(5G/6G) 및 시장 동향, 🏢 공공·산업망 및 간섭 관리, ⚖️ 글로벌 주파수 정책 및 법안]",
  "frequency_band": "관련 주파수 대역 (예: 6 GHz, MSS 대역, 700 MHz, 미정 등. 본문에 명시되지 않았으면 '-'로 표시)"
}}

[TITLE]
{title_en}

[FULL_TEXT]
{full_text_en}"""

    for attempt in range(1, max_retries + 1):
        try:
            response = client.chat.completions.create(
                model="gpt-4o-mini",
                messages=[
                    {
                        "role": "system",
                        "content": """당신은 통신, 주파수(Spectrum), 방송, IT 정책 분야 전문 번역가이자 요약 및 분류 전문가입니다.

[작업 원칙]
1. title_ko: 영어 원본 제목을 한국어로 자연스럽게 번역합니다.
2. summary_ko: 영어 본문을 읽고 가장 중요한 핵심 내용을 2~3문장으로 간결하게 직접 요약합니다.
3. full_text_ko: 영어 원본 본문을 빠짐없이 완전 번역합니다.
4. category: 기사의 주요 맥락을 분석하여 제시된 4개의 카테고리 중 하나로 정확히 분류합니다.
5. frequency_band: 기사에서 다루는 핵심 주파수 대역을 추출합니다.

[용어 규칙]
- reserve price = 최저입찰가
- coverage obligations = 망 구축 의무
- regional operators = 지역 사업자
- spectrum allocation = 주파수 할당

[출력 규칙]
- JSON만 출력합니다."""
                    },
                    {
                        "role": "user",
                        "content": prompt
                    }
                ],
                temperature=0.3,
                max_tokens=16000,
                top_p=1
            )
            time.sleep(1)

            raw = response.choices[0].message.content.strip()
            raw = raw.removeprefix("```json").removeprefix("```").removesuffix("```").strip()

            result = json.loads(raw)
            return result

        except json.JSONDecodeError as e:
            print(f"  ⚠️ JSON 파싱 실패 (시도 {attempt}/{max_retries}): {e}")
        except Exception as e:
            print(f"  ⚠️ API 호출 실패 (시도 {attempt}/{max_retries}): {e}")

        if attempt < max_retries:
            wait = 2 ** attempt
            print(f"  ⏳ {wait}초 후 재시도합니다...")
            time.sleep(wait)

    print("  ❌ 번역 최종 실패. 원문을 저장합니다.")
    return {
        "title_ko": title_en,
        "summary_ko": summary_en,
        "full_text_ko": full_text_en,
        "category": "기타/미분류",
        "frequency_band": "-"
    }

# ==========================================
# 4. 메인 실행 로직 (새 기사 확인 및 업데이트)
# ==========================================
def update_dashboard():
    print(f"[{datetime.now()}] 새로운 기사 업데이트를 시작합니다...")

    db = load_db()
    existing_urls = {item.get("url", "") for item in db}

    res = requests.get(RSS_URL, headers=HEADERS)
    if res.status_code != 200:
        print("페이지를 불러오는데 실패했습니다.")
        return

    soup = BeautifulSoup(res.content, 'xml')
    articles = soup.find_all('item')

    new_articles = []

    for art in articles:
        title_en = art.title.text.strip() if art.title else "제목 없음"
        url = art.link.text.strip() if art.link else ""
        
        if url in existing_urls:
            continue

        print(f"✨ [새로운 기사 발견] 번역 및 분류 중... : {title_en}")
        date_raw = art.pubDate.text.strip() if art.pubDate else "날짜 없음"

        desc_tag = art.description
        summary_en = BeautifulSoup(desc_tag.text, 'html.parser').text.strip() if desc_tag else "요약 없음"

        content_tag = art.find('content:encoded')
        full_text_en = BeautifulSoup(content_tag.text, 'html.parser').text.strip() if content_tag else summary_en

        translated = gpt_translate_all(title_en, summary_en, full_text_en)

        article_data = {
            "url": url,
            "title_en": title_en,
            "title_ko": translated.get("title_ko", title_en),
            "date": date_raw,
            "summary_en": summary_en,
            "summary_ko": translated.get("summary_ko", summary_en),
            "full_text_en": full_text_en,
            "full_text_ko": translated.get("full_text_ko", full_text_en),
            "category": translated.get("category", "기타/미분류"),
            "frequency_band": translated.get("frequency_band", "-")
        }
        new_articles.append(article_data)

    if not new_articles:
        print("✅ 새로 추가된 기사가 없습니다. 최신 상태입니다.")
    else:
        db = new_articles + db
        save_db(db)
        print(f"✅ {len(new_articles)}개의 새 기사가 DB에 추가되었습니다.")

    generate_html_dashboard(db)

# ==========================================
# 5. HTML 대시보드 렌더링 (카테고리 그룹화 적용)
# ==========================================
def generate_html_dashboard(db_data):
    # 카테고리별로 데이터 그룹화
    grouped_data = defaultdict(list)
    for idx, item in enumerate(db_data):
        # 기존 DB에 카테고리가 없는 경우를 위한 방어 코드
        cat = item.get("category", "기타/미분류")
        if cat not in ["🛰️ 위성통신 및 D2D", "📱 차세대 이동통신(5G/6G) 및 시장 동향", "🏢 공공·산업망 및 간섭 관리", "⚖️ 글로벌 주파수 정책 및 법안"]:
            cat = "기타/미분류"
        grouped_data[cat].append((idx, item))

    # 화면에 표시할 카테고리 순서 정의
    category_order = [
        "🛰️ 위성통신 및 D2D",
        "📱 차세대 이동통신(5G/6G) 및 시장 동향",
        "🏢 공공·산업망 및 간섭 관리",
        "⚖️ 글로벌 주파수 정책 및 법안",
        "기타/미분류"
    ]

    dashboard_html = ""
    hidden_contents = ""

    for cat in category_order:
        if cat not in grouped_data or not grouped_data[cat]:
            continue  # 해당 카테고리에 기사가 없으면 건너뜀
        
        rows_html = ""
        for idx, item in grouped_data[cat]:
            sum_ko = item.get('summary_ko', '').replace('\n', '<br>')
            txt_en = item.get('full_text_en', '').replace('\n', '<br><br>')
            txt_ko = item.get('full_text_ko', '').replace('\n', '<br><br>')
            freq_band = item.get('frequency_band', '-')

            rows_html += f"""
            <tr class="item-row" onclick="openNewWindow('article-{idx}')">
                <td class="col-band"><span class="badge">{freq_band}</span></td>
                <td class="col-title">
                    <strong>{item.get('title_ko', '')}</strong><br>
                    <span class="en-title">{item.get('title_en', '')}</span>
                </td>
                <td class="col-summary">{sum_ko}</td>
                <td class="col-date">{item.get('date', '')[:16]}</td>
            </tr>
            """

            hidden_contents += f"""
            <div id="article-{idx}" style="display: none;">
                <div style="max-width: 900px; margin: 0 auto; font-family: 'Malgun Gothic', sans-serif; color: #333; line-height: 1.7;">
                    <h2 style="color: #2c3e50; border-bottom: 2px solid #34495e; padding-bottom: 10px; line-height: 1.4;">{item.get('title_ko', '')}</h2>
                    <p style="color: #7f8c8d; font-size: 0.9em; margin-bottom: 10px;">발행일: {item.get('date', '')} | 카테고리: {cat}</p>
                    <p style="color: #2980b9; font-weight: bold; margin-bottom: 30px;">주파수 대역: {freq_band}</p>

                    <div style="background: #f8fafc; padding: 25px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 30px;">
                        <span style="background-color: #2980b9; color: white; padding: 5px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85em;">🇰🇷 한국어 번역 본문</span>
                        <div style="margin-top: 15px; font-size: 1.05em; color: #1a202c;">{txt_ko}</div>
                    </div>

                    <div style="background: #ffffff; padding: 25px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <span style="background-color: #7f8c8d; color: white; padding: 5px 12px; border-radius: 4px; font-weight: bold; font-size: 0.85em;">🇬🇧 영문 원본 본문</span>
                        <div style="margin-top: 15px; font-size: 0.95em; color: #4a5568;">{txt_en}</div>
                    </div>
                </div>
            </div>
            """

        dashboard_html += f"""
        <h2 class="category-title">{cat}</h2>
        <table>
            <thead>
                <tr>
                    <th class="col-band">대역</th>
                    <th class="col-title">기사 제목 (새 창 열림)</th>
                    <th class="col-summary">핵심 요약</th>
                    <th class="col-date">발행일</th>
                </tr>
            </thead>
            <tbody>
                {rows_html}
            </tbody>
        </table>
        """

    html_template = f"""
    <html>
    <head>
        <meta charset="utf-8">
        <title>PolicyTracker 동향 대시보드</title>
        <style>
            body {{ font-family: 'Malgun Gothic', sans-serif; background: #f4f6f9; padding: 30px; color: #333; }}
            .container {{ max-width: 1200px; margin: 0 auto; }}
            h1 {{ color: #2c3e50; border-bottom: 3px solid #34495e; padding-bottom: 10px; margin-bottom: 40px; }}
            
            .category-title {{ color: #2980b9; margin-top: 40px; margin-bottom: 15px; font-size: 1.4em; border-left: 5px solid #2980b9; padding-left: 10px; }}

            table {{ width: 100%; border-collapse: collapse; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }}
            th, td {{ padding: 15px 20px; border-bottom: 1px solid #e2e8f0; text-align: left; vertical-align: top; }}
            th {{ background-color: #34495e; color: white; font-size: 1.0em; }}

            .col-band {{ width: 10%; text-align: center; }}
            .col-title {{ width: 35%; font-size: 1.05em; }}
            .col-summary {{ width: 40%; font-size: 0.95em; line-height: 1.5; }}
            .col-date {{ width: 15%; font-size: 0.85em; color: #7f8c8d; }}

            .badge {{ display: inline-block; background-color: #e2e8f0; color: #2c3e50; padding: 4px 8px; border-radius: 12px; font-size: 0.85em; font-weight: bold; }}
            .en-title {{ font-size: 0.85em; color: #95a5a6; display: block; margin-top: 5px; }}

            .item-row {{ cursor: pointer; transition: background 0.2s; }}
            .item-row:hover {{ background-color: #f1f5f9; }}
            .item-row:hover .col-title strong {{ color: #2980b9; text-decoration: underline; }}
        </style>
        <script>
            function openNewWindow(articleId) {{
                var content = document.getElementById(articleId).innerHTML;
                var newWin = window.open('', '_blank');
                newWin.document.open();
                newWin.document.write('<html><head><title>기사 상세 본문</title></head><body style="background-color: #f4f6f9; padding: 40px;">' + content + '</body></html>');
                newWin.document.close();
            }}
        </script>
    </head>
    <body>
        <div class="container">
            <h1>📡 글로벌 주파수 정책 동향(PolicyTracker)</h1>
            {dashboard_html}
        </div>

        <div id="hidden-data">
            {hidden_contents}
        </div>
    </body>
    </html>
    """

    with open(HTML_FILE, "w", encoding="utf-8") as f:
        f.write(html_template)
    print(f"✅ 대시보드 업데이트 완료! '{HTML_FILE}' 파일이 생성되었습니다.")

if __name__ == "__main__":
    update_dashboard()
